
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sidebar Menu</title>

<style>
    * {
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
    }

    body {
        margin: 0;
        padding: 16px 10px;
        color: #222;
        background: #fff;
    }

    h2 {
        margin: 0 0 16px;
        font-size: 22px;
    }

    .acc-menu,
    .acc-menu ul {
        list-style: none;
        padding: 0;
        margin: 0;
        line-height: 1.5;
    }

    .acc-menu li {
        position: relative;
    }

    .acc-menu a {
        display: block;
        padding: 8px 10px;
        color: #222;
        text-decoration: none;
        overflow-wrap: anywhere;
    }

    .acc-menu a:hover {
        color: #d00;
        background: #f7f7f7;
    }

    /* Parent category */
    .acc-menu > li > .parent-link {
        padding-left: 34px;
        font-weight: bold;
        cursor: pointer;
    }

    /* Plus/minus icon */
    .acc-menu .toggle {
        position: absolute;
        top: 4px;
        left: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 32px;
        font-weight: bold;
        cursor: pointer;
        user-select: none;
    }

    .acc-menu .toggle::before {
        content: "+";
    }

    .acc-menu > li.open > .toggle::before {
        content: "\2212";
    }

    .acc-menu .toggle:focus-visible {
        outline: 2px solid #1677ff;
        outline-offset: 2px;
    }

    /* Child list: closed by default */
    .acc-menu > li > ul {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    /* Child links */
    .acc-menu > li > ul > li > a {
        padding-left: 34px;
        font-weight: normal;
    }

    @media (prefers-reduced-motion: reduce) {
        .acc-menu > li > ul {
            transition: none;
        }
    }
</style>
</head>

<body>
<h2>Menu</h2>

<ul class="acc-menu">
    <li>
        <span class="toggle" role="button" tabindex="0"
              aria-label="Toggle Parent Category 1"
              aria-expanded="false"></span>
        <a class="parent-link" href="#" aria-expanded="false">
            Parent Category 1
        </a>
        <ul>
            <li><a href="child1.html" target="mainFrame">Child Category</a></li>
            <li><a href="middle1.html" target="mainFrame">The Middle Child</a></li>
        </ul>
    </li>

    <li>
        <span class="toggle" role="button" tabindex="0"
              aria-label="Toggle Parent Category 2"
              aria-expanded="false"></span>
        <a class="parent-link" href="#" aria-expanded="false">
            Parent Category 2
        </a>
        <ul>
            <li><a href="child2.html" target="mainFrame">Child Category</a></li>
            <li><a href="middle2.html" target="mainFrame">The Middle Child</a></li>
        </ul>
    </li>

    <li>
        <span class="toggle" role="button" tabindex="0"
              aria-label="Toggle Parent Category 3"
              aria-expanded="false"></span>
        <a class="parent-link" href="#" aria-expanded="false">
            Parent Category 3
        </a>
        <ul>
            <li><a href="child3.html" target="mainFrame">Child Category</a></li>
            <li><a href="middle3.html" target="mainFrame">The Middle Child</a></li>
        </ul>
    </li>
</ul>

<script>
document.querySelectorAll(".acc-menu > li").forEach(function (item) {
    const toggle = item.querySelector(":scope > .toggle");
    const parentLink = item.querySelector(":scope > .parent-link");
    const submenu = item.querySelector(":scope > ul");

    function setOpen(open) {
        item.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
        parentLink.setAttribute("aria-expanded", String(open));

        if (open) {
            submenu.style.maxHeight = submenu.scrollHeight + "px";
        } else {
            submenu.style.maxHeight = "0";
        }
    }

    function toggleMenu(event) {
        if (event) event.preventDefault();
        setOpen(!item.classList.contains("open"));
    }

    toggle.addEventListener("click", toggleMenu);
    parentLink.addEventListener("click", toggleMenu);

    toggle.addEventListener("keydown", function (event) {
        if (event.key === "Enter" || event.key === " ") {
            toggleMenu(event);
        }
    });

    // Keep the submenu height correct if its contents change.
    submenu.addEventListener("transitionend", function () {
        if (item.classList.contains("open")) {
            submenu.style.maxHeight = submenu.scrollHeight + "px";
        }
    });
});
</script>

</body>
</html>
